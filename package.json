{
  "name": "organicgrowth",
  "version": "0.1.0",
  "private": true,
  "description": "OrganicGrowth Producer feature code: harness, deep modules, and plain-file state.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json --noEmit && node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.docs-test.ts\"",
    "test:docs": "node --import tsx --test \"src/**/*.docs-test.ts\"",
    "accept-idea": "tsx src/commands/accept-idea.ts",
    "queue": "tsx src/commands/queue.ts",
    "pick-cast": "tsx src/commands/pick-cast.ts",
    "pick": "tsx src/commands/pick.ts",
    "log-post": "tsx src/commands/log-post.ts",
    "track-performance": "tsx src/commands/track-performance.ts",
    "report": "tsx src/commands/report.ts",
    "run-pipeline": "tsx src/commands/run-pipeline.ts",
    "export-schedule": "tsx src/commands/export-schedule.ts",
    "cleanup-schedule-media": "tsx src/commands/cleanup-schedule-media.ts",
    "backup-media": "tsx src/commands/backup-media.ts",
    "import-data": "tsx src/importer/cli.ts",
    "backfill-hook-theme": "tsx src/commands/backfill-hook-theme.ts",
    "library": "tsx src/commands/run-library-viewer.ts",
    "media-host-smoke": "tsx src/media-host/live/smoke.ts",
    "space-driver-smoke": "tsx src/space-driver/live/smoke.ts",
    "apify-smoke": "tsx src/apify/live/smoke.ts"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.0",
    "@types/node": "^20.19.0",
    "tsx": "^4.22.0",
    "typescript": "^5.9.0"
  }
}
