    <script>
        (function () {
            var BASE = 'https://media.magnific.com/magnific-favicons';
            // Only SVG can swap colors via inline <style media="prefers-color-scheme: dark">; .ico/.png are raster and need separate dark-mode files.
            var ICONS = [
                { rel: 'icon', type: 'image/x-icon', light: '/favicon.ico', dark: '/favicon-dark.ico' },
                { rel: 'icon', type: 'image/svg+xml', light: '/favicon.svg?v=2', dark: '/favicon-dark.svg' },
                { rel: 'icon', type: 'image/png', sizes: '32x32', light: '/favicon-96x96.png?w=32&v=2', dark: '/favicon-dark-96x96.png?w=32' },
                { rel: 'icon', type: 'image/png', sizes: '16x16', light: '/favicon-96x96.png?w=16&v=2', dark: '/favicon-dark-96x96.png?w=16' },
                { rel: 'shortcut icon', type: 'image/x-icon', light: '/favicon-96x96.png?w=96&v=2', dark: '/favicon-dark-96x96.png?w=96' },
                { rel: 'icon', type: 'image/x-icon', light: '/favicon-96x96.png?w=96&v=2', dark: '/favicon-dark-96x96.png?w=96' }
            ];
            var mql = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
            function render() {
                var isDark = !!(mql && mql.matches);
                document.querySelectorAll('link[data-fav]').forEach(function (l) { l.remove(); });
                ICONS.forEach(function (i) {
                    var l = document.createElement('link');
                    l.rel = i.rel;
                    l.setAttribute('data-fav', '');
                    if (i.type) l.type = i.type;
                    if (i.sizes) l.setAttribute('sizes', i.sizes);
                    l.href = BASE + (isDark ? i.dark : i.light);
                    document.head.appendChild(l);
                });
            }
            render();
            if (mql && mql.addEventListener) mql.addEventListener('change', render);
            else if (mql && mql.addListener) mql.addListener(render);
        })();
    </script>
